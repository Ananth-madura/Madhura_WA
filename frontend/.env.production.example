# ============================================================================
# FRONTEND PRODUCTION ENV — set these in the Vercel dashboard
#   Settings -> Environment Variables
#
# Dashboard variables win over any file here, which is what you want: you can
# change a domain without a code change or a commit.
#
# HOW THE TWO HALVES TALK
#
#   REACT_APP_API_URL     LEAVE EMPTY.
#                         Empty makes the app call same-origin (/api/... on the
#                         Vercel domain) and vercel.json rewrites those paths to
#                         the backend. Same-origin means no CORS preflight, no
#                         third-party cookie blocking, nothing to keep in sync.
#
#   REACT_APP_SOCKET_URL  REQUIRED on Vercel Hobby. Vercel only proxies
#                         WebSocket upgrades on paid plans, so the Socket.IO
#                         client must connect straight to the backend.
#                         Leave it EMPTY on Pro/Enterprise and the socket falls
#                         back to the API origin and rides the /socket.io
#                         rewrite instead.
#
# The backend must list your Vercel domain in ALLOWED_ORIGINS.
#
# REACT_APP_* values are inlined into the bundle at BUILD time. Changing one
# requires a redeploy, not just a restart.
# ============================================================================

REACT_APP_API_URL=
REACT_APP_SOCKET_URL=https://wa-api.madhuratech.com

# ---------------------------------------------------------------------------
# Self-hosted (Docker + nginx) needs none of the above: nginx proxies /api,
# /uploads and /socket.io to the backend container on the same origin.
# ---------------------------------------------------------------------------
