# Whatsapp_CRM frontend — standalone WhatsApp UI
# Dev default backend: http://<host>:5001 (see src/config/index.js).
# Override when the backend lives elsewhere:
REACT_APP_API_URL=http://localhost:5001
# Direct cloud backend used as a login fallback when REACT_APP_API_URL is dead.
# Defaults to http://187.127.215.13:5001 when unset. Only tried on http pages,
# because browsers block http requests from an https page.
# REACT_APP_CLOUD_API_URL=http://187.127.215.13:5001
