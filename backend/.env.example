# =========================
# Whatsapp_CRM backend — standalone WhatsApp service
# Copy to .env and fill in. Ports/DB are intentionally DIFFERENT from the CRM
# (CRM: PORT=5000 / DB achme — here: PORT=5001 / DB madhura_wa) so both can run
# side by side during migration.
# =========================
PORT=5001
NODE_ENV=development

# PLURAL name — this is what config/corsPolicy.js reads. An older template used
# the singular ALLOWED_ORIGIN, which was ignored, so the allowlist was silently
# empty. In development an empty allowlist still works (any origin is reflected),
# which is why the mistake stayed invisible until production, where it blocks
# every browser request. Use the plural.
ALLOWED_ORIGINS=http://localhost:3001

# Password override login is disabled.

# Admin seed — used ONCE, to create the admin row if it does not exist.
# The seed does NOT overwrite the password on later boots, so rotating the
# admin password from the app sticks across restarts. Leave ADMIN_SEED_PASSWORD
# unset to skip the admin seed entirely.
ADMIN_SEED_EMAIL=admin@madhuratech.com
ADMIN_SEED_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT

# =========================
# Database (Options: MySQL OR Cloudflare R2 + SQLite)
# 
# Option A: MySQL
#   mysqldump -u root -p achme > achme_full.sql
#   The backend creates DB_NAME and applies its schema on startup.
#   For an existing installation, copy/verify data before changing DB_NAME.
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Set the actual MySQL credentials. Backend startup creates its database and
# schema; it does not install MySQL or reset server passwords.
# This is a LOCAL default only. Never reuse it in production, and never put a
# real password in a committed file: the server refuses to boot in production
# while this value is unchanged.
DB_PASS=CHANGE_ME_local_only
DB_NAME=madhura_wa

# =========================
# Option B: Cloudflare R2 Persistent Storage & Embedded SQLite
# Connected with Cloudflare R2 bucket `madhurawa` for 100% persistent storage with zero egress fees!
# =========================
DB_ENGINE=mysql
USE_SQLITE=0
R2_ACCOUNT_ID=7107deaae02b66284b790bfb60c66191
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=madhurawa
# R2_PUBLIC_DOMAIN=

# =========================
# Email (needed by /api/auth login/OTP/2FA — duplicated from CRM)
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# =========================
# Authentication — MUST match the CRM's JWT_SECRET initially so existing
# tokens keep validating. Rotate on both sides together later.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =========================
JWT_SECRET=CHANGE_ME_match_crm_jwt_secret_initially

# =========================
# WhatsApp Cloud API (Meta Official) — optional; leave blank to use the free
# WhatsApp Web session engine instead. When WA_APP_SECRET is set, inbound
# webhook requests are verified via X-Hub-Signature-256.
# Get these from: https://developers.facebook.com/apps -> Your App -> WhatsApp
# =========================
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_WABA_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=crm_verify_123
WA_BUSINESS_ACCOUNT_ID=
WA_DISPLAY_PHONE_NUMBER=
WA_VERIFIED_NAME=

# Public base URL of THIS backend, used to turn relative media paths
# (e.g. /uploads/wa-media/brochure.pdf) into absolute links WhatsApp can fetch.
# Must be publicly reachable for Meta Cloud API media to work.
PUBLIC_BASE_URL=http://localhost:5001

# Redis for WhatsApp message queue (BullMQ) — no Redis = synchronous fallback
REDIS_URL=redis://localhost:6379

# Interval between WhatsApp messages in ms (default 2000ms = 2 seconds)
WA_MESSAGE_INTERVAL=2000

# WhatsApp Web engine — which WhatsApp Web build the linked-device session runs.
# Defaults to a pinned known-good build. If scanning the QR links your phone but
# the session is immediately dropped ("disconnected: LOGOUT" in the server log),
# the pin has aged out — set to "latest" to negotiate the live build instead.
# WA_WEB_VERSION=latest

# Default session owner (users.id) for session_key backfill + legacy sends
# WA_DEFAULT_USER=1

# AI auto-reply — can also be set from the WhatsApp Accounts page in the UI.
# Get a free key at https://openrouter.ai
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_API_KEY=

# Stable credential encryption key: 32 UTF-8 bytes or 64 random hex characters.
SMTP_ENCRYPTION_KEY=CHANGE_ME
# Chat bodies and attachment archives are kept in the browser by default.
WA_SERVER_CHAT_STORAGE=0
