{
  "name": "whatsapp-crm-backend",
  "version": "1.0.0",
  "description": "Whatsapp_CRM standalone backend — WhatsApp session engine, Cloud API, campaigns, automations, flows, AI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/verify-shared-core.js",
    "test:legacy": "node scripts/run-tests.js",
    "verify:integration": "node scripts/verify-shared-core.js --integration",
    "verify:browser": "node scripts/verify-shared-core.js --integration --browser",
    "test:socket": "node scripts/check-socket-auth.js",
    "test:flows": "node tests/test_shared_flow_definition.js && node tests/test_flow_customization.js",
    "audit:auth": "node scripts/audit-auth.js",
    "production:preflight": "node scripts/production-preflight.js --database",
    "production:readiness": "node scripts/readiness-check.js",
    "verify:r2": "node scripts/check-r2.js --round-trip",
    "capacity:audit": "node scripts/capacity-audit.js",
    "ops:check": "node scripts/ops-check.js",
    "backup:mysql": "node scripts/backup-mysql.js",
    "verify": "node scripts/audit-auth.js && node scripts/check-socket-auth.js",
    "verify:all": "node scripts/verify-all.js",
    "postinstall": "patch-package || echo Patch applied or skipped",
    "test:degraded": "node scripts/test-degraded-mode.js",
    "test:free": "node scripts/test-free-tier.js",
    "test:zero-config": "node scripts/test-zero-config.js",
    "test:sqlite": "node scripts/test-sqlite-r2.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.11",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "node-schedule": "^2.1.1",
    "nodemailer": "^10.0.3",
    "patch-package": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.40.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "twilio": "^5.11.2",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
