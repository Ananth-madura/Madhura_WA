[Unit]
Description=Encrypted streaming MySQL backup
After=network-online.target mysql.service

[Service]
Type=oneshot
User=wauser
Group=wauser
WorkingDirectory=/home/wauser/app/backend
ExecStart=/usr/bin/flock -w 3600 /home/wauser/wa-data/backup.lock /usr/bin/node scripts/backup-mysql.js
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
