# ============================================================================
#  backend/.env.production.example  —  template for a hosted/VPS deploy
#
#      cp .env.production.example .env     (on the server)
#
#  .env is gitignored. Never commit the filled-in version — it holds DB_PASS,
#  JWT_SECRET, SMTP_PASS and the Meta access token.
#
#  ┌─────────────────────────────────────────────────────────────────────┐
#  │ Everything marked PREFILLED is already correct for production.      │
#  │ Everything marked CHANGE_ME must be set to a real value. The server │
#  │ refuses to boot in production while any CHANGE_ME remains, and      │
#  │ names the offending variables instead of failing mysteriously.      │
#  └─────────────────────────────────────────────────────────────────────┘
#
#  The frontend calls this API origin directly with credentialed requests.
#  Set matching public origins in both Vercel projects; see live_domains.md.
# ============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
ENABLE_RENDER_KEEP_ALIVE=0
DISABLE_RENDER_KEEP_ALIVE=1
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Independent webhook secret: configure the identical value in Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
# Set 0 to pause new paid checkouts without rejecting payment reconciliation.
RAZORPAY_CHECKOUT_ENABLED=1
BILLING_ALLOW_DEV_PAYMENTS=0
PORT=5001
TZ=Asia/Kolkata

# ── CORS: EXACT origins of the frontend. Comma-separated, PLURAL name. ─────
# This is the single most common breakage after a domain change. If the
# frontend and backend domains do not match exactly (including scheme and any
# www), the browser blocks every request and the console shows a CORS error
# while the server logs look perfectly healthy.
#
# NOTE the name: ALLOWED_ORIGINS (plural). The singular ALLOWED_ORIGIN is still
# honoured for backwards compatibility but should be renamed — the server logs
# a warning naming it.
#
# With NODE_ENV=production and this left EMPTY, all cross-origin browser
# requests are blocked. That is intentional — fail closed.
ALLOWED_ORIGINS=https://live.wa.madhuratech.in,https://wa.madhuratech.in

# ── Runtime state location ───────────────────────────────────────────────────
# MUST be outside the deploy directory, on a persistent disk. Holds the paired
# WhatsApp session (a full Chromium profile) and every uploaded invoice and
# image.
#
# CRITICAL: if this is unset, uploads/ and whatsapp-sessions/ are written
# INSIDE the deploy directory, so any deploy that replaces that directory
# orphans a live WhatsApp session — every number then has to be re-paired by
# walking to the phone with a QR scanner.
#   VPS    : mkdir -p /home/wauser/wa-data && set WA_DATA_DIR to that path
#   Render  : mount a disk and set WA_DATA_DIR to its mountPath
WA_DATA_DIR=/home/wauser/wa-data

# ── Database (MySQL or Cloudflare R2 + SQLite) ──────────────────────────────
# Option A: Real MySQL Server (VPS or Managed Cloud DB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME
DB_NAME=madhura_wa
WA_RUNTIME_PROFILE=small-vps
DB_POOL_LIMIT=10
DB_POOL_QUEUE_LIMIT=128
HTTP_JSON_LIMIT=2mb
HTTP_MAX_INFLIGHT=64
HTTP_MAX_UPLOADS=2
SOCKET_MAX_CONNECTIONS=1000
WA_WEBHOOK_CONCURRENCY=16
WA_AI_CONCURRENCY=4
WA_AI_PROVIDER_QUEUE=32
WA_RETENTION_INTERVAL_MS=300000
WA_ENABLE_CRM_SWEEP=0
# Generate privately; this operator token must never appear in the frontend.
OPS_METRICS_TOKEN=
# Configure and verify the encrypted repository before enabling the requirement.
BACKUP_REQUIRED=0
BACKUP_HOST_ID=wa-crm-prod
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# MySQL stays authoritative when optional R2 object storage is enabled.
DB_ENGINE=mysql
USE_SQLITE=0
DISABLE_R2=1
R2_REQUIRED=0
WA_ENABLE_WEB_ENGINE=0
REQUIRE_HARD_CONFIG=1
ALLOW_START_WITHOUT_DB=0
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=CHANGE_ME
# Keep the primary bucket private. Optional campaign assets use a SECOND bucket
# with a public custom domain. Do not connect that domain to the private bucket.
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must match the main Madhura CRM's JWT_SECRET initially, or tokens issued by
# one origin will be rejected by the other.
JWT_SECRET=CHANGE_ME

# Password override login is disabled.

# ── Admin seed ────────────────────────────────────────────────────────────────
# Used ONCE to create the admin row. The seed never rewrites the password on
# later boots, so a password changed in the app survives a restart.
# After the first successful boot you can remove ADMIN_SEED_PASSWORD.
ADMIN_SEED_EMAIL=admin@madhuratech.com
ADMIN_SEED_PASSWORD=CHANGE_ME

# ── Public URL of THIS backend ───────────────────────────────────────────────
# PREFILLED for wa-api.madhuratech.com.
# CRITICAL. Relative media paths (/uploads/wa-media/x.pdf) are expanded with this
# to build absolute links. Meta's Cloud API fetches those URLs from Facebook's
# servers, so this must be publicly reachable over HTTPS with a valid
# certificate. Setting it to localhost means outbound WhatsApp media silently
# fails while everything looks fine locally — the server now refuses to boot on
# a localhost or http value in production.
PUBLIC_BASE_URL=https://api.madhuratech.in

# ── WhatsApp Cloud API (Meta official) ───────────────────────────────────────
# Optional. Leave blank to use the free WhatsApp Web session engine instead.
# Developers.facebook.com -> Your App -> WhatsApp -> API Setup
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_WABA_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=CHANGE_ME
WA_BUSINESS_ACCOUNT_ID=
WA_DISPLAY_PHONE_NUMBER=
WA_VERIFIED_NAME=

# Pin a known-good WhatsApp Web build. If scanning the QR links your phone but
# the session drops immediately ("disconnected: LOGOUT" in the log), the pin has
# aged out — set to "latest" to negotiate the live build instead.
# WA_WEB_VERSION=latest

# ── Redis (BullMQ message queue) ─────────────────────────────────────────────
# No Redis means the backend falls back to synchronous sends. That works, but
# campaigns become slow and a slow API call can exceed Meta's per-message
# timing window.
REDIS_URL=redis://127.0.0.1:6379

# ── Email (auth OTP / 2FA) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ── AI auto-reply ────────────────────────────────────────────────────────────
# Also settable from the WhatsApp Accounts page in the UI.
# Naming the provider and model in your privacy policy is a DPDP expectation
# once this is on. See DEPLOYMENT.md -> "AI and data".
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_API_KEY=

# ── Messaging behaviour ──────────────────────────────────────────────────────
# Milliseconds between outbound WhatsApp messages. 2000ms = 2 seconds.
WA_MESSAGE_INTERVAL=2000

# Legacy sessions owner for backfill. Leave unset unless you are migrating.
# WA_DEFAULT_USER=1

# Stable credential encryption key: 32 UTF-8 bytes or 64 random hex characters.
SMTP_ENCRYPTION_KEY=CHANGE_ME
# Chat bodies and attachment archives are kept in the browser by default.
WA_SERVER_CHAT_STORAGE=0
AUTH_BROWSER_COOKIES=1
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SITE_DOMAIN=madhuratech.com
WA_LEGACY_PUBLIC_UPLOADS=0
WA_METADATA_RETENTION_DAYS=30
WA_DEDUPE_RETENTION_DAYS=14
WA_AUDIT_RETENTION_DAYS=90
